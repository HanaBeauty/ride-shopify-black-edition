{%- comment -%}
  Prévia funcional: Mini-carrinho PRO em drawer
  Não altera cart atual; use para testes em página custom.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'maquia-pro-preview.css' | asset_url }}" media="all">
<script src="{{ 'maquia-pro-preview.js' | asset_url }}" defer></script>

<button class="maquia-top-bar__cta" data-maquia-cart-toggle>{{ section.settings.trigger_label }}</button>

<div class="maquia-drawer" data-maquia-drawer data-free-shipping="{{ section.settings.free_shipping | default: 0 }}" data-cart-subtotal="{{ cart.total_price | divided_by: 100.0 }}">
  <div class="maquia-drawer__overlay" data-maquia-overlay></div>
  <aside class="maquia-drawer__panel" role="dialog" aria-label="Mini-carrinho">
    <div class="maquia-drawer__header">
      <div>
        <p class="maquia-pill">{{ section.settings.pill }}</p>
        <h3>{{ section.settings.title }}</h3>
      </div>
      <button type="button" data-maquia-close aria-label="Fechar">✕</button>
    </div>

    <div class="maquia-drawer__items">
      {%- if cart != blank and cart.item_count > 0 -%}
        {%- for item in cart.items -%}
          <article class="maquia-drawer__line">
            <div>
              {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.product.title }}
            </div>
            <div>
              <p style="font-weight:700;">{{ item.product.title }}</p>
              <p>{{ item.variant_title }}</p>
              <p>{{ item.price | money }} × {{ item.quantity }}</p>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        <p>Nenhum item no carrinho. Use para prévia visual.</p>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'cross_sell' -%}
          <article class="maquia-drawer__line">
            {%- if block.settings.image -%}
              <div>{{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: block.settings.title }}</div>
            {%- endif -%}
            <div>
              <p style="font-weight:700;">{{ block.settings.title }}</p>
              <p>{{ block.settings.text }}</p>
              {%- if block.settings.link -%}
                <a class="maquia-mega__cta" href="{{ block.settings.link }}">Adicionar →</a>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="maquia-drawer__summary">
      <div class="maquia-progress" aria-label="Barra de frete grátis">
        <div class="maquia-progress__bar" data-progress-bar></div>
      </div>
      <p>{{ section.settings.progress_text }}</p>
      <button class="maquia-top-bar__cta" style="width:100%; text-align:center; justify-content:center;" onclick="window.location.href='{{ routes.cart_url }}'">{{ section.settings.checkout_label }}</button>
    </div>
  </aside>
</div>

{% schema %}
{
  "name": "Prévia - Drawer Cart PRO",
  "tag": "section",
  "class": "section-maquia-preview",
  "settings": [
    {"type": "text", "id": "trigger_label", "label": "Texto do botão", "default": "Abrir mini-carrinho PRO"},
    {"type": "text", "id": "pill", "label": "Pill", "default": "Carrinho"},
    {"type": "text", "id": "title", "label": "Título", "default": "Resumo e cross-sell"},
    {"type": "text", "id": "progress_text", "label": "Texto frete grátis", "default": "Faltam R$30,00 para frete grátis"},
    {"type": "number", "id": "free_shipping", "label": "Alvo frete grátis (R$)", "default": 199},
    {"type": "text", "id": "checkout_label", "label": "CTA checkout", "default": "Ir para checkout"}
  ],
  "blocks": [
    {
      "type": "cross_sell",
      "name": "Cross-sell manual",
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Imagem"},
        {"type": "text", "id": "title", "label": "Título", "default": "Complete seu look"},
        {"type": "text", "id": "text", "label": "Texto", "default": "Sugestão de produto complementar."},
        {"type": "url", "id": "link", "label": "Link"}
      ]
    }
  ],
  "presets": [{"name": "Prévia: Drawer Cart PRO"}]
}
{% endschema %}
