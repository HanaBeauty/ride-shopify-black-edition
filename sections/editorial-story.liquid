{%- comment -%}
  Prévia funcional: Seção editorial / história da marca
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'maquia-pro-preview.css' | asset_url }}" media="all">

<section class="maquia-editorial">
  <div class="maquia-editorial__image">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | img_url: '720x' }}" alt="{{ section.settings.title }}" loading="lazy" width="720" height="480">
    {%- else -%}
      <div style="background:#f1f5f9; height:100%; border-radius:1rem; display:grid; place-items:center; color:#94a3b8;">
        Placeholder visual
      </div>
    {%- endif -%}
  </div>
  <div>
    <p class="maquia-pill">{{ section.settings.pill }}</p>
    <h2>{{ section.settings.title }}</h2>
    <p>{{ section.settings.text }}</p>
    {%- if section.settings.cta_label and section.settings.cta_link -%}
      <a class="maquia-mega__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }} →</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Prévia - História da marca",
  "tag": "section",
  "class": "section-maquia-preview",
  "settings": [
    {"type": "text", "id": "pill", "label": "Pill", "default": "Nossa história"},
    {"type": "text", "id": "title", "label": "Título", "default": "Clube Hana em movimento"},
    {"type": "textarea", "id": "text", "label": "Texto", "default": "Conte sobre propósito, ingredientes e bastidores."},
    {"type": "text", "id": "cta_label", "label": "CTA", "default": "Conhecer"},
    {"type": "url", "id": "cta_link", "label": "Link CTA"},
    {"type": "image_picker", "id": "image", "label": "Imagem"}
  ],
  "presets": [{"name": "Prévia: História da marca"}]
}
{% endschema %}
