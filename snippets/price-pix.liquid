{% liquid
  assign variant = product.selected_or_first_available_variant
  assign full_price = variant.price
  assign percent = settings.pix_discount_percent | divided_by: 100

  assign discount_amount = full_price | times: percent
  assign pix_price = full_price | minus: discount_amount
%}

<div class="hana-price-wrapper">

  <div class="hana-price-pix">
    {{ pix_price | money }} {{ settings.pix_discount_label }} ({{ settings.pix_discount_percent }}% OFF)
  </div>

  <div class="hana-price-full">
    ou {{ full_price | money }} em até 6x sem juros
  </div>

</div>
